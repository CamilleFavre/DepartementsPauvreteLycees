#  fig-cap: "Atlas 200 m de Rennes : revenus, pauvreté, habitat et établissements"
library(leaflet); library(sf); library(dplyr)
library(htmltools); library(stringr)

os_name <- Sys.info()[["sysname"]]

# Attribution des chemins selon l'OS
if (os_name == "Windows") {
  dossier_donnees <- "G:/Mon Drive/Education/Master APE 25-27/Mémoire/Données MicroMetrics/france_metro/"

} else if (os_name == "Darwin") { # macOS
  dossier_donnees <- "/Users/camillefavre/Mon Drive/Education/Master APE 25-27/Mémoire/Données MicroMetrics/france_metro/"
} else {
  stop("Système d'exploitation non pris en charge.")
}

gpkg_path <- paste0(dossier_donnees, "carreaux_200m_met.gpkg")
CODE <- "35238"   # Rennes

# --- Carreaux 200 m de Rennes uniquement (requête SQL = rapide) ---
carreaux_sf <- st_read(gpkg_path,
  query = sprintf("SELECT * FROM carreaux_200m_met WHERE lcog_geo LIKE '%s%%'", CODE),
  quiet = TRUE) %>%
  st_transform(4326) %>%
  mutate(
    taux_pauvrete = ifelse(men > 0, men_pauv / men * 100, NA),
    part_proprio  = ifelse(men > 0, men_prop / men * 100, NA),
    revenu_moyen  = ifelse(ind > 0, ind_snv / ind, NA),
    part_maison   = ifelse(men > 0, men_mais / men * 100, NA)
  )

# --- Contour de la commune ---
commune <- tryCatch(
  st_read(paste0("https://geo.api.gouv.fr/communes/", CODE, "?format=geojson&geometry=contour"), quiet = TRUE),
  error = function(e) NULL)

# --- Palettes ---
pal_pauv <- colorNumeric(c("#22c55e", "#fef08a", "#ef4444"), domain = carreaux_sf$taux_pauvrete, na.color = "transparent")
pal_rev  <- colorNumeric("Purples", domain = carreaux_sf$revenu_moyen, na.color = "transparent")
pal_pop  <- colorNumeric("Blues",  domain = carreaux_sf$ind, na.color = "transparent")
pal_prop <- colorNumeric("YlGn",   domain = carreaux_sf$part_proprio, na.color = "transparent")

# --- Carte ---
m <- leaflet(width = "100%", height = "640px") %>%
  addProviderTiles(providers$Esri.WorldGrayCanvas) %>%
  addPolygons(data = carreaux_sf, color = "#cbd5e1", weight = 0.2,
    fillColor = ~pal_pauv(taux_pauvrete), fillOpacity = 0.7,
    popup = ~paste0("<b>Carreau 200 m</b><br>Taux de pauvreté : ",
                    round(taux_pauvrete, 1), "%<br>Ménages pauvres : ",
                    men_pauv, " / ", men),
    group = "Taux de pauvreté") %>%
  addPolygons(data = carreaux_sf, color = "#cbd5e1", weight = 0.2,
    fillColor = ~pal_rev(revenu_moyen), fillOpacity = 0.7,
    popup = ~paste0("<b>Carreau 200 m</b><br>Revenu moyen : ",
                    round(revenu_moyen, 0), " €/uc"),
    group = "Revenu moyen") %>%
  addPolygons(data = carreaux_sf, color = "#cbd5e1", weight = 0.2,
    fillColor = ~pal_pop(ind), fillOpacity = 0.7,
    popup = ~paste0("<b>Carreau 200 m</b><br>Population : ", ind),
    group = "Population") %>%
  addPolygons(data = carreaux_sf, color = "#cbd5e1", weight = 0.2,
    fillColor = ~pal_prop(part_proprio), fillOpacity = 0.7,
    popup = ~paste0("<b>Carreau 200 m</b><br>Propriétaires : ",
                    round(part_proprio, 1), "%"),
    group = "Part de propriétaires") %>%
  addPolygons(data = commune, color = "#1e293b", weight = 1.5,
    fillColor = "transparent", group = "Contour commune") %>%
  addLayersControl(
    baseGroups = c("Taux de pauvreté", "Revenu moyen", "Population", "Part de propriétaires"),
    overlayGroups = c("Contour commune"),
    options = layersControlOptions(collapsed = FALSE)) %>%
  setView(lng = -1.678, lat = 48.11, zoom = 12)

m
```
