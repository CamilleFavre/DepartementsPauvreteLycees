  slice_head(n = 20) %>%
  mutate(rang = row_number())

p2 <- ggplot(top_n, aes(x = reorder(rang, contrib_theil), y = contrib_theil)) +
  geom_col(fill = "#b2182b") +
  labs(title = "Top 20 most unequal cells", x = "Cell (ranked)", y = "Contribution") +
  theme_minimal(base_size = 10)

p1 + p2
